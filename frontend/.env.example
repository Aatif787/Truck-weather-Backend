# API Base URL pointing to the Django backend
VITE_API_BASE_URL=http://127.0.0.1:8001

# Optional Map Tile Configuration:
# By default, MapView uses standard OpenStreetMap tiles (no API key required for dev).
# To use CARTO Light tiles without watermarks, provide a CARTO API key:
# VITE_CARTO_API_KEY=your_carto_api_key_here
#
# Alternatively, to use a custom tile server (e.g. MapTiler, self-hosted OSM, Stadia):
# VITE_MAP_TILE_URL=https://your-custom-tile-server/{z}/{x}/{y}.png

