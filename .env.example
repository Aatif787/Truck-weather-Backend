# Django Backend Configuration
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=True
DJANGO_PORT=8001
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-backend-domain.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com

# OpenRouteService API Key (Server-side only)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Frontend Configuration (Client-side)
VITE_API_BASE_URL=http://127.0.0.1:8001
# VITE_CARTO_API_KEY=your_optional_carto_api_key_here
# VITE_MAP_TILE_URL=https://your-custom-tile-server/{z}/{x}/{y}.png
